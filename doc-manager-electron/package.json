{
  "name": "doc-manager-desktop",
  "version": "1.0.0",
  "description": "文档管理器桌面版",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "copy:backend": "node scripts/copy-backend.js",
    "start": "npm run copy:backend && npm run build && electron .",
    "dist": "npm run copy:backend && npm run build && electron-builder",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "szr",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@types/node": "^26.4.1",
    "copyfiles": "^2.4.1",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "debug": "^4.4.3",
    "env-paths": "^3.0.0",
    "graceful-fs": "^4.2.11",
    "ms": "^2.1.3",
    "progress": "^2.0.3",
    "semver": "^7.8.5",
    "sumchecker": "^3.0.1",
    "undici": "^7.29.0",
    "undici-types": "^7.18.2"
  },
  "build": {
    "appId": "com.szr.docmanager",
    "productName": "文档管理器",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/backend.jar",
        "to": "backend.jar"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
